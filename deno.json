{
  "version": "0.1.0",
  "license": "Apache-2.0",
  "tasks": {
    "dev": "deno run --allow-read --allow-write --allow-env --allow-run main.ts",
    "check": "deno check main.ts cli_test.ts src/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "test": "deno test -A",
    "ok": "deno fmt --check && deno lint && deno check main.ts cli_test.ts src/*.ts && deno test -A",
    "build": "./build.sh",
    "build:win": "./build.sh windows"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
