{
  "version": "0.1.2",
  "license": "Apache-2.0",
  "imports": {
    "@std/path": "jsr:@std/path@^1"
  },
  "tasks": {
    "dev": "deno run --allow-read --allow-write --allow-env --allow-run --allow-net=api.github.com,github.com,objects.githubusercontent.com,release-assets.githubusercontent.com main.ts",
    "check": "deno check main.ts cli_test.ts build.ts src/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "test": "deno test -A",
    "ok": "deno fmt --check && deno lint && deno check main.ts cli_test.ts build.ts src/*.ts && deno test -A",
    "hooks": "git config core.hooksPath .githooks",
    "build": "deno run -A build.ts",
    "build:win": "deno run -A build.ts windows"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
